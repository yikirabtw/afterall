# Скопируйте в .env и поменяйте под себя.
# Без .env используется локальный SQLite-файл backend/dev.db.

# PostgreSQL (продакшен):
# DATABASE_URL=postgresql+psycopg://teammates:password@localhost:5432/teammates

# Токен бота от @BotFather (никому не показывайте и не коммитьте):
# BOT_TOKEN=123456789:AAH...

# Адрес мини-приложения (только https):
# WEBAPP_URL=https://example.com

# Telegram ID админов — им приходят жалобы с кнопками бана (несколько — через запятую):
# ADMIN_TELEGRAM_IDS=123456789
